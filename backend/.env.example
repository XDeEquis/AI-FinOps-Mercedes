# Copia este fichero a ".env" y ajusta los valores.
# cp .env.example .env

PORT=3000

# Ruta del fichero SQLite (opcional, por defecto backend/finops.db)
# FINOPS_DB_PATH=./finops.db

# Poner en "true" SOLO cuando los proveedores estén realmente disponibles:
# 1) cd material && docker compose up -d
# 2) Descargar los modelos dentro de los contenedores:
#    docker exec ollama-provider-a ollama pull llama3.2:3b
#    docker exec ollama-provider-b ollama pull mistral:7b
# 3) Poner ENABLE_REAL_PROVIDERS=true y reiniciar "npm start"
ENABLE_REAL_PROVIDERS=false

# Necesaria solo si ENABLE_REAL_PROVIDERS=true y se usa el Provider C (Groq).
# Consíguela gratis en https://console.groq.com/keys
# IMPORTANTE: esta clave SOLO vive en el backend (proceso Node). Nunca se
# envía al frontend ni aparece en ninguna respuesta HTTP del proxy.
GROQ_API_KEY=gsk_your_key_here

# Presupuesto mensual por defecto (USD) asignado a cada equipo/consumer al
# crearse por primera vez la base de datos. Es el límite configurable que
# exige el reto: al superarse, el proxy bloquea peticiones (HTTP 403) y
# genera alertas visibles. Cambialo aquí antes del primer arranque, o en
# caliente durante la demo con:
#   PATCH /v1/consumers/:consumerId/budget  { "monthly_budget_usd": 10 }
FINOPS_DEFAULT_BUDGET_USD=5.0

# (Opcional) URL de un webhook externo (Slack, Teams, Zapier, make.com...)
# al que el proxy hará POST cada vez que un equipo cruce el 80%, 90% o 100%
# de su presupuesto. Si se deja vacío, la alerta sigue siendo visible por
# consola del backend + tabla `notifications` + banner en la UI del chat.
# FINOPS_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
